38); quando há Agendamento, Paciente e Psicólogo são os mesmos dele." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#243447;spacing=0;fontSize=13;fontStyle=0;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1500" height="22" as="geometry" /></mxCell><mxCell id="area-4-52" value="Cada revisão cria uma nova Versão da Evolução; versões nunca são apagadas e só o autor revisa (RF-040, RN-028)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#243447;spacing=0;fontSize=13;fontStyle=0;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="40" y="744" width="1500" height="22" as="geometry" /></mxCell><mxCell id="area-4-53" value="A Evolução é restrita ao Psicólogo autor; Documento (área 08) é separado para que compartilhar não exponha a Evolução (RN-029)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#243447;spacing=0;fontSize=13;fontStyle=0;fontColor=#243447;" vertex="1" parent="1"><mxGeometry x="40" y="768" width="1500" height="22" as="geometry" /></mxCell><mxCell id="area-4-54" value="04 / 09  |  Tipos: UUID, String, Boolean, Integer, Decimal, Date, Time, DateTime e as enumerações («enumeration») de cada área." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#243447;spacing=0;fontSize=11;fontStyle=0;fontColor=#5A6A7A;" vertex="1" parent="1"><mxGeometry x="40" y="804" width="1500" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="area-5" name="05 Recorrência"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="area-5-1" value="Recorrência" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#243447;spacing=0;fontSize=28;fontStyle=1;fontColor=#213B56;" vertex="1" parent="1"><mxGeometry 